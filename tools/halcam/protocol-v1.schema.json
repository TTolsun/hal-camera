{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TTolsun/hal-camera/protocol-v1.schema.json",
  "title": "HALCamera v1 submission contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "command",
    "params",
    "execution_timeout_ms"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "command": {
      "enum": [
        "cameras",
        "preview",
        "preview.stop",
        "capture",
        "record.start",
        "probe",
        "cts.cases",
        "cts.run"
      ]
    },
    "execution_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(custom|vendored):"
          }
        },
        "audio": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "cameras",
              "preview.stop",
              "probe",
              "cts.cases"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "camera_id"
                  ]
                },
                {
                  "required": [
                    "cases"
                  ]
                },
                {
                  "required": [
                    "audio"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "preview",
              "capture"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "camera_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cases"
                  ]
                },
                {
                  "required": [
                    "audio"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "record.start"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "camera_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cases"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "cts.run"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "required": [
              "cases"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "camera_id"
                  ]
                },
                {
                  "required": [
                    "audio"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
