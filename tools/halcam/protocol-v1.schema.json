          "type": "string",
          "pattern": "^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}$"
        },
        "yuv_size": {
          "type": "string",
          "pattern": "^(off|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
        },
        "jpeg_size": {
          "type": "string",
          "pattern": "^(yuv|off|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
        },
        "video_size": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}$"
        },
        "video_fps": {
          "type": "string",
          "pattern": "^(0*[1-9]|0*[1-9][0-9]|0*1[0-9]{2}|0*2[0-3][0-9]|0*240)$"
        },
        "codec": {
          "enum": [
            "H264",
            "HEVC",
            "Auto"
          ]
        },
        "raw_size": {
          "type": "string",
          "pattern": "^(off|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
        },
        "fps": {
          "type": "string",
          "pattern": "^(auto|[1-9][0-9]{0,2}(-[1-9][0-9]{0,2})?)$"
        },
        "stabilization": {
          "enum": [
            "AUTO",
            "OFF",
            "OIS",
            "VIDEO",
            "PREVIEW"
          ]
        }
      }
    },
    "profile_id": {
      "const": "camera2-standard-v2"
    }
