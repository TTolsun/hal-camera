  "$id": "https://github.com/TTolsun/hal-camera/protocol-v1.schema.json",
  "title": "HALCamera v1 submission contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "command",
    "params",
    "execution_timeout_ms"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "command": {
      "enum": [
        "burst",
        "bracket",
        "meter",
        "events",
        "live.info",
        "dual.cameras",
        "dual.preview",
        "dual.capture",
        "dual.record",
        "results.list",
        "results.show",
        "results.export",
        "results.compare",
        "results.delete",
        "baseline.add",
        "baseline.remove",
        "gallery.list",
        "gallery.export",
        "gallery.delete",
        "streams",
        "cameras",
        "preview",
        "preview.stop",
        "capture",
        "record.start",
        "probe",
        "cts.cases",
        "cts.run",
        "benchmark.run"
      ]
    },
    "execution_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(custom|vendored):"
          }
        },
        "audio": {
          "type": "boolean"
        },
        "engine": {
          "enum": [
            "Camera2",
            "CameraX"
          ]
        },
        "streams": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "preview_size": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}$"
            },
            "yuv_size": {
              "type": "string",
              "pattern": "^(off|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
            },
            "jpeg_size": {
              "type": "string",
              "pattern": "^(off|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
            },
            "video_size": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}x[1-9][0-9]{0,4}$"
            },
            "video_fps": {
              "type": "string",
              "pattern": "^(0*[1-9]|0*[1-9][0-9]|0*1[0-9]{2}|0*2[0-3][0-9]|0*240)$"
            },
            "codec": {
              "enum": [
                "H264",
                "HEVC",
                "Auto"
              ]
            },
            "raw_size": {
              "type": "string",
              "pattern": "^(off|[1-9][0-9]{0,4}x[1-9][0-9]{0,4})$"
            },
            "fps": {
              "type": "string",
              "pattern": "^(auto|[1-9][0-9]{0,2}(-[1-9][0-9]{0,2})?)$"
            },
            "stabilization": {
              "enum": [
                "AUTO",
                "OFF",
                "OIS",
                "VIDEO",
                "PREVIEW"
              ]
            },
            "yuv_format": {
              "enum": [
                "JPEG",
                "NV21"
              ]
            }
          }
        },
        "profile_id": {
          "const": "camera2-standard-v2"
        },
        "options": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "ae_lock": {
              "type": "string"
            },
            "af_lock": {
              "type": "string"
            },
            "confirm": {
              "type": "string"
            },
