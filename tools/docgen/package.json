{
  "name": "halcamera-docgen",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "HALCamera 문서 파이프라인 진입점. 실제 파이프라인은 공용 엔진 @ttolsun/omm-doc-workflow 이며, 이 패키지는 엔진과 프로젝트 어댑터만 연결합니다.",
  "dependencies": {
    "@ttolsun/omm-doc-workflow": "git+https://github.com/TTolsun/omm-doc-workflow.git#v0.6.1"
  },
  "scripts": {
    "check": "node docflow.mjs check",
    "check:build": "node docflow.mjs check --build",
    "verify": "node docflow.mjs verify",
    "accept": "node docflow.mjs verify --accept",
    "generate": "node docflow.mjs generate",
    "site": "node docflow.mjs site build",
    "sync": "node docflow.mjs sync",
    "test": "node --test regression.test.mjs workflow.test.mjs"
  }
}
