{
  "name": "halcamera-docgen",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "HALCamera 문서 생성기. Qwen 동기화에만 OMM 의존성이 필요합니다.",
  "dependencies": { "oh-my-mermaid": "0.2.0" },
  "scripts": {
    "extract": "node extract.mjs",
    "verify": "node verify.mjs",
    "generate": "node generate.mjs",
    "check": "node verify.mjs --check && node generate.mjs --check",
    "accept": "node verify.mjs --accept",
    "test": "node --test regression.test.mjs sync.test.mjs"
  }
}
